def island_boxes(name):
    ob = O[name]; bm = bmesh.new(); bm.from_mesh(ob.data); bm.transform(ob.matrix_world); bm.verts.ensure_lookup_table(); seen = set(); out = []
    for v0 in bm.verts:
        if v0.index in seen: continue
        st = [v0]; comp = []; seen.add(v0.index)
        while st:
            a = st.pop(); comp.append(a.co.copy())
            for e in a.link_edges:
                b = e.other_vert(a)
                if b.index not in seen: seen.add(b.index); st.append(b)
        out.append((Vector((min(p.x for p in comp), min(p.y for p in comp), min(p.z for p in comp))), Vector((max(p.x for p in comp), max(p.y for p in comp), max(p.z for p in comp)))))
    bm.free(); return out
