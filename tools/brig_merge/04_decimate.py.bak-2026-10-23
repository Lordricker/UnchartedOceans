
import bpy, bmesh, os, time
WORK = os.path.join(os.environ["BRIG_PROJECT"], "tools", "brig_merge")
exec(open(os.path.join(WORK, "merge_lib.py")).read(), globals())
LOG = open(os.path.join(WORK, "stage4_log.txt"), "a", encoding="utf-8")
def L(m): LOG.write(m + "\n"); LOG.flush(); os.fsync(LOG.fileno())
OUT = os.environ["MERGE_OUT"]; O = bpy.data.objects
ROPEM = {"M_Rope_Tar", "M_Rope_Hemp", "M_Rope_Boltrope"}
# name -> (ratio, symmetric, decimate_ropes_too)
TARGETS = {"Hull": (0.55, True, False), "Interiors": (0.55, False, False), "DeckFittings": (0.58, False, False), "Rig_Spars": (0.55, False, False),
           "Rig_Ropes": (0.33, False, True), "Wheel": (0.40, False, False)}
for i in range(6): TARGETS[f"Gun_{i}"] = (0.42, False, False)
def tri_of(me): return sum(len(p.vertices) - 2 for p in me.polygons)
L(f"=== stage4 start {time.strftime('%H:%M:%S')}")
# ---------- phase 1: split + attach decimate modifiers (all scene changes happen here) ----------
jobs = {}; tmp_col = coll("__tmp")
for name, (ratio, sym, rope_too) in TARGETS.items():
    ob = O[name]; me0 = ob.data; before = tri_of(me0)
    rope_idx = {i for i, m in enumerate(me0.materials) if m and m.name in ROPEM} if not rope_too else set()
    parts = []
    for keep_rope in (False, True):
        if keep_rope and not rope_idx: continue
        m_ = me0.copy(); m_.name = f"__{name}_{'rope' if keep_rope else 'rest'}"
        bm = bmesh.new(); bm.from_mesh(m_)
        dead = [f for f in bm.faces if ((f.material_index in rope_idx) != keep_rope)]
        if dead: bmesh.ops.delete(bm, geom=dead, context='FACES')
        bmesh.ops.delete(bm, geom=[v for v in bm.verts if not v.link_faces], context='VERTS'); bm.to_mesh(m_); bm.free(); parts.append((keep_rope, m_))
    rest = next(m for k, m in parts if not k); rope = next((m for k, m in parts if k), None)
    tmp = bpy.data.objects.new(f"__dec_{name}", rest); tmp_col.objects.link(tmp)
    md = tmp.modifiers.new("dec", 'DECIMATE'); md.decimate_type = 'COLLAPSE'; md.ratio = ratio; md.use_collapse_triangulate = True
    if sym: md.use_symmetry = True; md.symmetry_axis = 'X'
    jobs[name] = {"obj": ob, "tmp": tmp, "rope": rope, "before": before, "ratio": ratio}
    L(f"PREP {name}: {before} tris, ratio {ratio}, rope-preserved faces={len(rope.polygons) if rope else 0}")
# ---------- phase 2: evaluate everything (no scene changes between evaluations) ----------
dg = bpy.context.evaluated_depsgraph_get(); baked = {}
for name, j in jobs.items():
    L(f"EVAL {name}"); baked[name] = bpy.data.meshes.new_from_object(j["tmp"].evaluated_get(dg)); L(f"EVAL {name} ok: {tri_of(baked[name])} tris")
# ---------- phase 3: put the decimated meshes back ----------
for name, j in jobs.items():
    bm = bmesh.new(); bm.from_mesh(baked[name])
    if j["rope"] is not None: bm.from_mesh(j["rope"])
    ob = j["obj"]; old = ob.data; new = bpy.data.meshes.new(old.name + "_dec"); bm.to_mesh(new); bm.free()
    for m in old.materials: new.materials.append(m)
    # material indices of the decimated copy follow the original slot order, so they carry over unchanged
    for p in new.polygons:
        if p.material_index >= len(new.materials): p.material_index = 0
    for pl in new.polygons: pl.use_smooth = True
    ob.data = new; new.name = old.name
    L(f"DONE {name}: {j['before']} -> {tri_of(new)} tris ({round(100*tri_of(new)/max(j['before'],1))}%) | mats {[m.name if m else None for m in new.materials][:6]}...")
for name, j in jobs.items():
    bpy.data.objects.remove(j["tmp"])
for m in list(bpy.data.meshes):
    if m.name.startswith("__") or (m.users == 0 and m.name.endswith("_dec")): bpy.data.meshes.remove(m)
bpy.data.collections.remove(tmp_col)
tot = sum(tri_of(o.data) for o in bpy.data.collections["Brig_Export"].all_objects if o.type == 'MESH'); L(f"TOTAL base tris now {tot}")
bpy.data.orphans_purge(do_recursive=True); bpy.ops.wm.save_as_mainfile(filepath=OUT); L("SAVED " + OUT); L("=== stage4 finished")
