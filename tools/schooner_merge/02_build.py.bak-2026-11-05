    if n == "CamTarget_Compass": return {"type": "camera_target", "game_role": "camera_marker"}
    if n == "Station_Wheel": return {"type": "helm", "item": "Wheel", "game_role": "station"}
    if n in ("Station_Sheet_Fore", "Station_Sheet_Main"): return {"type": "sheet", "sail": n.split("_")[-1], "game_role": "station"}
    if n in ("Station_Halyard_Fore", "Station_Halyard_Main"): return {"type": "halyard", "sail": n.split("_")[-1], "game_role": "station"}
    if n.startswith("Station_Halyard_Jib"): return {"type": "halyard", "sail": "Jib", "game_role": "station"}
    if n.startswith("Station_Sheet_Jib"): return {"type": "sheet", "sail": "Jib", "side": "port" if x > 0 else "stbd", "game_role": "station"}
    if n.startswith("Station_Sheet_Staysail"): return {"type": "sheet", "sail": "ForeStaysail", "side": "port" if x > 0 else "stbd", "game_role": "station"}
    if n.startswith("Station_Gun_"): return {"type": "gun", "gun": "Gun_" + n[-1], "side": "port" if x > 0 else "stbd", "game_role": "station"}
    if n == "Station_Pump_01": return {"type": "pump", "pump": "Pump", "game_role": "station"}
    if n == "Station_LogLine": return {"type": "log_line", "note": "knotted log line goes over the stern rail", "game_role": "station"}
    if n == "Station_Mooring": return {"type": "mooring", "game_role": "station"}
    if n == "Station_Bed": return {"type": "bed", "game_role": "station"}
