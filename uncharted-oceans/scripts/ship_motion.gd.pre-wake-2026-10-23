extends Node3D
## Floats the ship on the Ocean: samples the wave height at points around the hull and
## eases heave, pitch and roll toward the plane through them (a heavy hull doesn't follow
## every ripple). The deck collision (ShipBody, an AnimatableBody3D) follows this node,
## so the player is carried along.
##
## Sails drive the ship (ship_sails.gd, sail_model.gd): speed, leeway, heel and weather helm all come
## from how the sails are set and trimmed against the wind. F is now only a test engine that
## overrides the sails with a steady ahead_speed.
## Keys (in game): F = toggle the test engine (about 5 knots), R = toggle wave motion on/off.
## Also feeds the ocean shader the ship transform so no water is drawn inside the hull.
## Extra weight (flood water, later cargo) pushes the ship down and over through load_offset.

@export var ocean_path: NodePath = ^"../Ocean"
@export var ship_path: NodePath = ^"Brig"
@export var floating := true
## Ship-local (x, z) points where the hull feels the water. Bow is -Z.
@export var sample_points := PackedVector2Array([
	Vector2(0, -8.0), Vector2(0, 7.5),
	Vector2(-2.6, -4.0), Vector2(2.6, -4.0),
	Vector2(-3.0, 0.5), Vector2(3.0, 0.5),
	Vector2(-2.7, 5.0), Vector2(2.7, 5.0),
])
## Seconds for the hull to catch up with the water (bigger = heavier, slower ship).
@export var heave_lag := 0.7
@export var pitch_lag := 0.9
@export var roll_lag := 1.3
## Extra roll on top of the wave slope (a narrow hull rolls more than the slope alone).
@export var roll_gain := 1.25
@export var draft_offset := 0.0
@export var ahead_speed := 2.6   ## m/s when F is on (~5 knots)
@export_range(0.0, 360.0) var heading_deg := 0.0

## Steering: the wheel (ship_wheel.gd) sets rudder, -1 = hard to port .. +1 = hard to starboard.
## The ship only turns while underway. max_turn_rate_deg is the turn at full rudder; turn_lag is
## how many seconds the heavy hull takes to build up (and lose) its turn.
@export var wheel_enabled := true
## Helm commands while you hold the wheel (ship_helm.gd) and the windsock on the poop deck (ship_windsock.gd).
@export var helm_enabled := true
@export var windsock_enabled := true
## The log line: shown only from the wheel's stern view, knots run out with the ship's speed (ship_log_line.gd).
@export var log_line_enabled := true
## The cabin bookshelf: look at the books, read them (ship_bookshelf.gd, book_reader.gd).
@export var bookshelf_enabled := true
## White outline on the compass, cannons and pumps while you look at them (ship_interact.gd).
@export var interact_enabled := true
## The bilge pump handle: grab it and the pumps go on (ship_pump.gd).
@export var pump_enabled := true
## Click the captain's bed to open the sleep window (ship_bed.gd; needs the world scene's WorldStreamer).
@export var bed_enabled := true
## The chart on the cabin table: click it and it fills the screen (ship_map.gd, chart_canvas.gd; needs the world scene).
@export var map_enabled := true
## Climb the shrouds and the mast to the lookout barrel (ship_rigging.gd; the zones and waypoints are markers in the brig).
@export var rigging_enabled := true
## Test aid: a big rock in the sea (sea_rock.gd) so you can see the ship turn and move.
## Placed at this offset from where the ship starts, in the ship's starting orientation
## (-Z = ahead, -X = to port).
@export var test_rock := true
@export var test_rock_offset := Vector3(-45.0, 0.0, -110.0)
## Test island (island.gd) with a cove and a pier, and the harbour logic (ship_harbor.gd: running aground,
## the pier, mooring). Placed at this offset from where the ship starts, in the ship's starting orientation.
@export var test_island := true
@export var test_island_offset := Vector3(70.0, 0.0, -215.0)
@export var harbor_enabled := true
## Size class for docking (ShipClasses.Size): sets the light rectangle at a berth and how gently she must arrive.
@export_enum("Small", "Medium", "Large") var ship_class := 1
@export var max_turn_rate_deg := 4.0
@export var turn_lag := 2.5
var rudder := 0.0
## Sailing (see ShipSails). With the sails on, speed / side_speed / sail_roll come from the sail model.
@export var sails_enabled := true
var sails: ShipSails
var speed := 0.0             ## m/s through the water, forward
var side_speed := 0.0        ## m/s sideways (leeway), + starboard
var sail_roll := 0.0         ## radians, + raises the starboard side (the sails' heel, negative = leaning starboard)
## Current turn, degrees per second (+ = to port, the way heading_deg grows).
var yaw_rate_deg := 0.0

## Build an outside collision skin from the visible hull mesh (see _build_hull_skin).
@export var hull_skin := true
@export var hull_mesh_name := "Hull"
@export_range(1, 32) var hull_skin_layer := 3
var underway := false
var _xf_prev := Transform3D()
var _xf_dt := 0.0
## Extra (heave, pitch, roll) from weight aboard, set each tick by ship_flooding.gd.
## Heave is in metres (negative = lower), pitch and roll in radians, same signs as the waves.
var load_offset := Vector3.ZERO
var _ocean: Ocean
var _ship: Node3D
var _heave := 0.0
var _pitch := 0.0
var _roll := 0.0
var _heave_v := 0.0
var _pitch_v := 0.0
var _roll_v := 0.0
var _amount := 1.0

func _ready() -> void:
	add_to_group("ships")
	_ocean = get_node_or_null(ocean_path) as Ocean
	_ship = get_node_or_null(ship_path)
	if _ocean == null:
		push_warning("ship_motion: no Ocean found at %s" % ocean_path)
	var mat := _ocean.get_ocean_material() if _ocean else null
	if mat and _ship:
		var ex := _find_waterline(_ship)
		if ex.is_empty():
			push_warning("ship_motion: no waterline data on the ship; sea will show inside the hull")
		else:
			var hb := PackedFloat32Array(ex["waterline_half_beam"])
			mat.set_shader_parameter("half_beam", hb)
			mat.set_shader_parameter("sample_count", hb.size())
			mat.set_shader_parameter("y_min", float(ex["waterline_y_min"]))
			mat.set_shader_parameter("y_step", float(ex["waterline_y_step"]))
	if _ocean:
		_heave = _ocean.get_height(global_position.x, global_position.z)
	if _ship and hull_skin:
		_build_hull_skin(_ship)
	_unsync_bodies(self)
	if test_rock and get_parent() and get_parent().get_node_or_null("SeaRock") == null:
		var rock := Node3D.new()
		rock.set_script(load("res://scripts/sea_rock.gd"))
		rock.name = "SeaRock"
		var yaw := Basis(Vector3.UP, deg_to_rad(heading_deg))
		rock.position = Vector3(global_position.x, 0.0, global_position.z) + yaw * test_rock_offset
		get_parent().add_child.call_deferred(rock)
	if wheel_enabled and get_node_or_null("ShipWheel") == null:
		var wheel = load("res://scripts/ship_wheel.gd").new()
		wheel.name = "ShipWheel"
		add_child(wheel)
	if sails_enabled and get_node_or_null("ShipSails") == null:
		sails = ShipSails.new()
		sails.name = "ShipSails"
		add_child(sails)
	if wheel_enabled and helm_enabled and get_node_or_null("ShipHelm") == null:
		var helm = load("res://scripts/ship_helm.gd").new()
		helm.name = "ShipHelm"
		add_child(helm)
	if log_line_enabled and get_node_or_null("ShipLogLine") == null:
		var ll = load("res://scripts/ship_log_line.gd").new()
		ll.name = "ShipLogLine"
		add_child(ll)
	if interact_enabled and get_node_or_null("ShipInteract") == null:
		var inter = load("res://scripts/ship_interact.gd").new()
		inter.name = "ShipInteract"
		add_child(inter)
	if rigging_enabled and get_node_or_null("ShipRigging") == null:
		var rig = load("res://scripts/ship_rigging.gd").new()
		rig.name = "ShipRigging"
		add_child(rig)
	if map_enabled and get_node_or_null("ShipMap") == null:
		var map = load("res://scripts/ship_map.gd").new()
		map.name = "ShipMap"
		add_child(map)
	if bed_enabled and get_node_or_null("ShipBed") == null:
		var bed = load("res://scripts/ship_bed.gd").new()
		bed.name = "ShipBed"
		add_child(bed)
	if pump_enabled and get_node_or_null("ShipPump") == null:
		var pump = load("res://scripts/ship_pump.gd").new()
		pump.name = "ShipPump"
		add_child(pump)
	if bookshelf_enabled and get_node_or_null("ShipBookshelf") == null:
		var shelf = load("res://scripts/ship_bookshelf.gd").new()
		shelf.name = "ShipBookshelf"
		add_child(shelf)
	if windsock_enabled and get_node_or_null("Windsock") == null:
		var sock = load("res://scripts/ship_windsock.gd").new()
		sock.name = "Windsock"
		add_child(sock)
	if test_island and get_parent() and get_parent().get_node_or_null("Island") == null:
		var isl := Island.new()
		isl.name = "Island"
		var yaw_i := Basis(Vector3.UP, deg_to_rad(heading_deg))
		isl.position = Vector3(global_position.x, 0.0, global_position.z) + yaw_i * test_island_offset
		get_parent().add_child.call_deferred(isl)
	if harbor_enabled and get_node_or_null("ShipHarbor") == null:
		var hb := ShipHarbor.new()
		hb.name = "ShipHarbor"
		add_child(hb)

## The deck and hull collision live in AnimatableBody3D nodes under the ship. With
## sync_to_physics on, they only follow their *own* local transform, so when this rig
## moves them through their parent the collision stays behind. Turned off, every parent
## move is sent to physics as a kinematic move (with velocity), which carries the player.
## Outside collision that matches the visible hull, so swimmers bump the planking instead of
## sinking ~35 cm into it (the deck collision's walls sit inside the hull). Built from the hull
## mesh at startup, keeping only faces that point out of the ship, one-sided, on its own layer
## (hull_skin_layer) so the flood grid's scans don't see it. The player collides with it.
func _build_hull_skin(ship: Node3D) -> void:
	var mi := ship.find_child(hull_mesh_name, true, false) as MeshInstance3D
	if mi == null or mi.mesh == null:
		push_warning("ship_motion: no '%s' mesh found for the hull skin" % hull_mesh_name)
		return
	var to_ship := ship.global_transform.affine_inverse() * mi.global_transform
	var faces := PackedVector3Array()
	var kept := 0
	for s in mi.mesh.get_surface_count():
		var arr := mi.mesh.surface_get_arrays(s)
		var v: PackedVector3Array = arr[Mesh.ARRAY_VERTEX]
		var idx: PackedInt32Array = arr[Mesh.ARRAY_INDEX] if arr[Mesh.ARRAY_INDEX] != null else PackedInt32Array()
		var n := idx.size() if idx.size() > 0 else v.size()
		for i in range(0, n - 2, 3):
			var a := to_ship * v[idx[i] if idx.size() > 0 else i]
			var b := to_ship * v[idx[i + 1] if idx.size() > 0 else i + 1]
			var c := to_ship * v[idx[i + 2] if idx.size() > 0 else i + 2]
			var nrm := (b - a).cross(c - a)
			if nrm.length_squared() < 1e-12:
				continue
			nrm = -nrm.normalized()          # Godot front faces are clockwise
			var m := (a + b + c) / 3.0
			var outward := (nrm.x * signf(m.x) > 0.3 and absf(m.x) > 0.8) \
				or (nrm.y < -0.5 and m.y < 0.3) \
				or (nrm.z * signf(m.z) > 0.5 and absf(m.z) > 6.0)
			if outward:
				faces.append_array([a, b, c])
				kept += 1
	if kept == 0:
		return
	var shape := ConcavePolygonShape3D.new()
	shape.set_faces(faces)
	shape.backface_collision = false
	var body := AnimatableBody3D.new()
	body.name = "HullSkin"
	body.sync_to_physics = false
	body.collision_layer = 1 << (hull_skin_layer - 1)
	body.collision_mask = 0
	var cs := CollisionShape3D.new()
	cs.shape = shape
	body.add_child(cs)
	ship.add_child(body)

func _unsync_bodies(n: Node) -> void:
	if n is AnimatableBody3D:
		(n as AnimatableBody3D).sync_to_physics = false
	for c in n.get_children():
		_unsync_bodies(c)

func _find_waterline(n: Node) -> Dictionary:
	if n.has_meta("extras"):
		var e = n.get_meta("extras")
		if e is Dictionary and e.has("waterline_half_beam"):
			return e
	for c in n.get_children():
		var r := _find_waterline(c)
		if not r.is_empty():
			return r
	return {}

func _unhandled_input(e: InputEvent) -> void:
	if e is InputEventKey and e.pressed and not e.echo:
		if e.physical_keycode == KEY_R:
			floating = not floating
		elif e.physical_keycode == KEY_F:
			underway = not underway

## Target heave, pitch, roll from the water under the sample points (least-squares plane).
func water_pose() -> Vector3:
	var yaw := deg_to_rad(heading_deg)
	var fwd := Vector2(-sin(yaw), -cos(yaw))    # world xz of ship -Z
	var right := Vector2(cos(yaw), -sin(yaw))   # world xz of ship +X
	var hs := PackedFloat32Array()
	var mean := 0.0
	for sp in sample_points:
		var w := Vector2(global_position.x, global_position.z) + right * sp.x - fwd * sp.y
		var h := _ocean.get_height(w.x, w.y)
		hs.append(h)
		mean += h
	mean /= sample_points.size()
	var sxh := 0.0; var sxx := 0.0; var szh := 0.0; var szz := 0.0
	for i in sample_points.size():
		var sp := sample_points[i]
		sxh += sp.x * (hs[i] - mean); sxx += sp.x * sp.x
		szh += sp.y * (hs[i] - mean); szz += sp.y * sp.y
	var roll := atan(sxh / maxf(sxx, 0.001)) * roll_gain   # +roll raises ship +X
	var pitch := atan(-szh / maxf(szz, 0.001))             # +pitch raises the bow (-Z)
	return Vector3(mean, pitch, roll)

func _physics_process(delta: float) -> void:
	_xf_prev = global_transform
	_xf_dt = delta
	_amount = move_toward(_amount, 1.0 if floating else 0.0, delta * 0.3)
	if sails and sails.is_physics_processing():
		# the sail model owns speed, leeway, heel and the turn (rudder + weather helm)
		var m := sails.model
		yaw_rate_deg = m.yaw_rate
		speed = m.v_f
		side_speed = m.v_s
		sail_roll = -m.heel
		heading_deg = fposmod(heading_deg + yaw_rate_deg * delta, 360.0)
		var yaw_s := deg_to_rad(heading_deg)
		var fwd_s := Vector3(-sin(yaw_s), 0.0, -cos(yaw_s))
		var right_s := Vector3(cos(yaw_s), 0.0, -sin(yaw_s))
		global_position += (fwd_s * speed + right_s * side_speed) * delta
	else:
		var want_rate := -clampf(rudder, -1.0, 1.0) * max_turn_rate_deg if underway else 0.0
		yaw_rate_deg = lerpf(yaw_rate_deg, want_rate, 1.0 - exp(-delta / maxf(turn_lag, 0.05)))
		heading_deg = fposmod(heading_deg + yaw_rate_deg * delta, 360.0)
		if underway:
			var yaw := deg_to_rad(heading_deg)
			global_position += Vector3(-sin(yaw), 0.0, -cos(yaw)) * ahead_speed * delta
			speed = ahead_speed
		else:
			speed = 0.0
	var target := water_pose() * _amount if _ocean else Vector3.ZERO
	target += load_offset
	target.z += sail_roll
	_heave = _spring(_heave, target.x, heave_lag, delta, 0)
	_pitch = _spring(_pitch, target.y, pitch_lag, delta, 1)
	_roll = _spring(_roll, target.z, roll_lag, delta, 2)
	position.y = _heave + draft_offset
	basis = Basis(Vector3.UP, deg_to_rad(heading_deg)) \
		* Basis(Vector3.RIGHT, _pitch) * Basis(Vector3.BACK, _roll)

## World velocity of a point riding on the ship this physics frame (deck, ladder, hold water).
## Used to hand the ship's motion to a player who jumps, swims or climbs off it.
func velocity_at(p: Vector3) -> Vector3:
	if _xf_dt <= 0.0:
		return Vector3.ZERO
	var before := _xf_prev * (global_transform.affine_inverse() * p)
	return (p - before) / _xf_dt

# Critically damped spring toward target, so motion has some weight and no jitter.
func _spring(x: float, target: float, lag: float, dt: float, which: int) -> float:
	var omega := 2.0 / maxf(lag, 0.05)
	var v: float = [_heave_v, _pitch_v, _roll_v][which]
	var ex := exp(-omega * dt)
	var change := x - target
	var temp := (v + omega * change) * dt
	v = (v - omega * temp) * ex
	var out := target + (change + temp) * ex
	match which:
		0: _heave_v = v
		1: _pitch_v = v
		2: _roll_v = v
	return out

func _process(_delta: float) -> void:
	if _ocean and _ship and _ocean.get_ocean_material():
		_ocean.get_ocean_material().set_shader_parameter("ship_inv", Projection(_ship.global_transform.affine_inverse()))
